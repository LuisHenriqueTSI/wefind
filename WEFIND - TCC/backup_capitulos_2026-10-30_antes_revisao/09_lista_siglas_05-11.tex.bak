\thispagestyle{empty}
\begin{center}
    \textbf{\large LISTA DE SIGLAS E ABREVIATURAS}
\end{center}
\vspace{0.8cm}

\begin{singlespacing}
\noindent
\begin{longtable}{p{3.5cm} p{11.5cm}}
ABNT & Associação Brasileira de Normas Técnicas \\
API & \textit{Application Programming Interface} (Interface de Programação de Aplicações) \\
APK & \textit{Android Package} (Pacote de Aplicativo Android) \\
CEP & Comitê de Ética em Pesquisa \\
CNS & Conselho Nacional de Saúde \\
CSTSI & Curso Superior de Tecnologia em Sistemas para Internet \\
FK & \textit{Foreign Key} (Chave Estrangeira) \\
GPS & \textit{Global Positioning System} (Sistema de Posicionamento Global) \\
HTTP & \textit{Hypertext Transfer Protocol} (Protocolo de Transferência de Hipertexto) \\
HTTPS & \textit{Hypertext Transfer Protocol Secure} (Protocolo Seguro de Transferência de Hipertexto) \\
IA & Inteligência Artificial \\
IBGE & Instituto Brasileiro de Geografia e Estatística \\
IEC & \textit{International Electrotechnical Commission} \\
IFSul & Instituto Federal de Educação, Ciência e Tecnologia Sul-rio-grandense \\
IHC & Interação Humano-Computador \\
ISO & \textit{International Organization for Standardization} \\
JSX & \textit{JavaScript XML} (extensão de sintaxe do JavaScript) \\
JWT & \textit{JSON Web Token} \\
LGPD & Lei Geral de Proteção de Dados Pessoais \\
MobSF & \textit{Mobile Security Framework} \\
OAuth & \textit{Open Authorization} (protocolo aberto de autorização) \\
OTP & \textit{One-Time Password} (Código de Autenticação de Uso Único) \\
PK & \textit{Primary Key} (Chave Primária) \\
PKCE & \textit{Proof Key for Code Exchange} (Chave de Prova para Troca de Código) \\
PNS & Pesquisa Nacional de Saúde \\
QR & \textit{Quick Response} (Resposta Rápida) \\
REST & \textit{Representational State Transfer} (Transferência de Estado Representacional) \\
RF & Requisito Funcional \\
RLS & \textit{Row Level Security} (Segurança em Nível de Linha) \\
RNF & Requisito Não Funcional \\
SDK & \textit{Software Development Kit} (Kit de Desenvolvimento de Software) \\
SHA & \textit{Secure Hash Algorithm} (Algoritmo de Resumo Seguro) \\
SRD & Sem Raça Definida \\
SUS & \textit{System Usability Scale} (Escala de Usabilidade do Sistema) \\
UC & Caso de Uso (\textit{Use Case}) \\
UML & \textit{Unified Modeling Language} (Linguagem de Modelagem Unificada) \\
URL & \textit{Uniform Resource Locator} (Localizador Uniforme de Recursos) \\
W3C & \textit{World Wide Web Consortium} \\
WCAG & \textit{Web Content Accessibility Guidelines} (Diretrizes de Acessibilidade para Conteúdo Web) \\
\end{longtable}
\end{singlespacing}

\clearpage
