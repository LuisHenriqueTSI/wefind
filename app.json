{
  "expo": {
    "name": "WeFIND",
    "slug": "wefind-app",
    "version": "2.8.4",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "wefind",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às suas fotos para registrar itens",
          "cameraPermission": "Permitir acesso à câmera para tirar fotos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir acesso à localização para escolher o ponto no mapa"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wefind.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Permitir acesso às suas fotos para registrar itens",
        "NSCameraUsageDescription": "Permitir acesso à câmera para tirar fotos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "image": "./assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.wefind.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "EXPO_PUBLIC_SUPABASE_URL": "",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "",
      "EXPO_PUBLIC_GEMINI_API_KEY": "",
      "EXPO_PUBLIC_GEMINI_MODEL": "gemini-2.0-flash",
      "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "",
      "eas": {
        "projectId": "63b36b6f-0196-4471-8c1e-9d96f840f737"
      }
    },
    "owner": "luishenrique.tsi2"
  }
}
